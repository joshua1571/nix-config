@startuml
!include <tupadr3/common>
!include <tupadr3/font-awesome-6/globe>
!include <tupadr3/font-awesome-6/wifi>
!include <tupadr3/font-awesome-6/network_wired>
!include <tupadr3/font-awesome-6/server>
!include <tupadr3/font-awesome-6/computer>
!include <tupadr3/font-awesome-6/laptop>
!include <tupadr3/font-awesome-6/mobile>
!include <tupadr3/font-awesome-6/plug_circle_bolt>
!include <tupadr3/font-awesome-6/keyboard>

hide stereotype
skinparam shadowing false

!$PLANNED = "#back:FFF5F5;line:C0392B;line.dashed"
!$PLANNED_LINK  = "[#C0392B,dashed]"

title Homelab — Physical Layout

FA6_GLOBE(internet, "Internet\nGoogle Fiber")
FA6_WIFI(router, "Router\nHW: Flint 2 (GL-MT6000)")
FA6_NETWORK_WIRED(sw, "Switch\nHW: UGREEN 35372US")

FA6_SERVER(server01, "server01\nHW: Custom\nOS: NixOS\nRole: Production Env")
FA6_SERVER(monitor01, "monitor01\nHW: Rasbperry Pi 4 (4GB)\nOS: Raspberry Pi OS\nRole: Monitoring") $PLANNED
FA6_LAPTOP(admin01, "admin01\nHW: Old Dell Laptop\nOS: NixOS\nRole: Dev Server") $PLANNED
FA6_COMPUTER(desktop, "desktop01\nHW: Custom\nOS: NixOS\nRole: Test Env")
FA6_LAPTOP(laptop, "laptop01\nHW: Asus Vivobook S M5406W\nOS: NixOS\nRole: Dev Client")
FA6_MOBILE(phone, "JRH iPhone\nHW: iPhone 15 Pro\nOS: iOS")

FA6_KEYBOARD(kvm, "KVM01\nHW: Comet PoE (GL-RM1PE)")
FA6_PLUG_CIRCLE_BOLT(ups, "UPS01\n HW: TBD") $PLANNED

internet -- router : 1 Gb
router .. laptop : WiFi
router .. phone : WiFi
router -- sw
sw -- server01
sw -- admin01
sw -- monitor01
sw -- desktop

kvm -- server01 : out-of-band
kvm -- admin01 : out-of-band
ups .$PLANNED_LINK. desktop :power
ups .$PLANNED_LINK. sw : power
ups .$PLANNED_LINK. server01 : power
ups .$PLANNED_LINK. admin01 : power

legend bottom
  <color:#C0392B>dashed red</color> = planned, not yet built
endlegend
@enduml